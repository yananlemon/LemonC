# Keep source and documentation files stable across Windows/macOS/Linux.
* text=auto eol=lf

# Windows command scripts are the only CRLF exception.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts must never be line-ending normalized.
*.jar binary
*.png binary
*.class binary
*.exe binary
