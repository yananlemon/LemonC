class MultipleJumps {
    void main() {
        int i;
        i = 0;
        
        while (i < 10) {
            i = i + 1;
            
            if (i == 1) {
                continue; // skipped
            }
            if (i == 2) {
                continue; // skipped
            }
            if (i == 3) {
                printf("Reached %d (should be 3)\n", i);
            }
            if (i == 4) {
                break; // stop completely
            }
            if (i == 5) {
                break; // unreachable, but syntactically correct and will patch correctly
            }
        }
        printf("End of multiple jumps. i=%d\n", i);
    }
}
