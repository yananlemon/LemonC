class CompoundAssign {
    void main() {
        int i;
        int sum;
        int k;
        int values[4];
        sum = 0;
        for (i = 0; i < 4; i++) {
            values[i] = i + 1;
        }
        for (i = 0; i < 4; i++) {
            values[i] *= 10;
        }
        for (i = 0; i < 4; i++) {
            sum += values[i];
        }
        printf("sum=%d\n", sum);
        k = 20;
        k -= 4;
        k /= 2;
        k %= 5;
        printf("k=%d\n", k);
        values[3]++;
        i--;
        printf("last=%d,i=%d\n", values[3], i);
    }
}
